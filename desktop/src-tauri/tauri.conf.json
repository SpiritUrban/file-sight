{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileSight",
  "version": "0.6.2",
  "identifier": "com.filesight.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FileSight",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/filesight-thumbnails/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "dmg", "app"],
    "publisher": "Vitaliy Dyachuk",
    "copyright": "Copyright (c) 2026 Vitaliy Dyachuk",
    "homepage": "https://spiriturban.github.io/file-sight/",
    "license": "MIT",
    "shortDescription": "Local image and video analysis that suggests readable file names.",
    "longDescription": "FileSight analyses images and short videos locally with a vision model and suggests human-readable file names. Nothing is renamed without explicit confirmation, every operation is journalled, and any rename can be undone.",
    "category": "Utility",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/SpiritUrban/file-sight/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1Nzc4MDMzQ0ZGQzNFQUYKUldTdlB2elBNNEIzaFJrSFVtRHNHYjJMTFBZSjJBK1JBYmtVQVhtUmRkMUxWMlVWTTlLcWtOZzcK"
    }
  }
}
