# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/

# Tooling
.pytest_cache/
.mypy_cache/

# FileSight output
filesight-report.json

# Local test data
test-images/

# A locally dropped FFmpeg build (auto-detected, must not be committed)
ffmpeg/
ffmpeg-*/
ffmpeg.exe
ffprobe.exe

# Desktop (Tauri + React)
desktop/node_modules/
desktop/dist/
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/src-tauri/app-icon.png

# Updater signing keys. Losing them is unrecoverable (every installed copy
# stops accepting updates); committing them is worse. They live only on the
# owner's machine and in GitHub Actions secrets.
.tauri-key
.tauri-key.*

# Generated in CI from the GitHub release; never committed.
site/download-manifest.json

# OS
Thumbs.db
.DS_Store

# Local ONNX model pack (junction or copy); never committed.
models/
